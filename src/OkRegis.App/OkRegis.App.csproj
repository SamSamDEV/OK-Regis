<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OkRegis.Core\OkRegis.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="obs-websocket-dotnet" Version="5.7.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
    <PackageReference Include="System.Speech" Version="11.0.0" />
    <PackageReference Include="Vosk" Version="0.3.38" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.2</Version>
    <Product>OK Régis</Product>
    <Description>Voice assistant for OBS</Description>
    <ApplicationIcon>Assets\okregis.ico</ApplicationIcon>
    <!-- Réglages d'économie : un seul ramasse-miettes léger, pas de thread de fond, démarrage sans compilation à la volée. -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <PublishReadyToRun>true</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Utilise la globalisation de Windows (NLS) au lieu d'ICU : moins de mémoire. -->
    <RuntimeHostConfigurationOption Include="System.Globalization.UseNls" Value="true" />
    <!-- Le ramasse-miettes garde le tas plus compact. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

</Project>